PORT=3000
HOST=127.0.0.1
PREFIX=!
BOT_NAME=OS NOTURNOS
CREATOR_NAME=Equipe OS NOTURNOS
CREATOR_CONTACT=
AUTH_DIR=./auth
DATA_FILE=./data/database.json
WHATSAPP_ENABLED=true
# QR ou pairing. Número internacional, somente dígitos.
AUTH_MODE=qr
PAIRING_PHONE=
# Chave obrigatória para liberar o QR no site hospedado.
# No Render, use uma senha longa e exclusiva e não publique este valor.
PANEL_SECRET=
MAX_RECONNECT_ATTEMPTS=8
COMMAND_COOLDOWN_MS=3000
XP_COOLDOWN_MS=60000
MAX_MESSAGE_LENGTH=4000
TIMEZONE=America/Sao_Paulo
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Obrigatório somente para Ollama; exemplo http://127.0.0.1:11434
AI_BASE_URL=
AI_TIMEOUT_MS=30000
STICKER_PACK=OS NOTURNOS
STICKER_AUTHOR=OS NOTURNOS
FFMPEG_PATH=ffmpeg
MAX_MEDIA_BYTES=10485760
MAX_VIDEO_SECONDS=6
# OpenWeatherMap
WEATHER_API_KEY=
# Instância LibreTranslate
TRANSLATE_URL=
TRANSLATE_API_KEY=
# Token TinyURL
SHORTENER_API_KEY=

# Pasta opcional do site compilado.
SITE_DIR=./public

OPEN_BROWSER=true
